# ==============================================================
# ConoHa サーバー / 本番環境 設定テンプレート
# ==============================================================

# --- サーバー基本設定 ---
# 待受ポート番号 (ConoHa VPS で PM2 / systemd 実行時: 3001)
PORT=3001

# 実行環境 ('production' または 'development')
NODE_ENV=production

# 待受ホスト (0.0.0.0 で全外部インターフェースからリッスン)
CONOHA_SERVER_HOST=0.0.0.0

# 許可するクライアントCORSオリジン (同一サーバー配信時は * またはドメイン)
CORS_ORIGIN=*

# --- 永続データ保存先 ---
# ConoHa サーバー上のデータ保存ディレクトリ (デフォルト: ./data)
DATA_DIR=./data

# --- フロントエンド API 接続設定 (Vite) ---
# 同一オリジン配信・Nginxリバースプロキシ時は '/api' のままで動作します
# フロントエンドとバックエンドを別ホストにする場合は URL を指定 (例: https://your-conoha-domain.jp/api)
VITE_API_BASE_URL=/api

# --- AI Studio / Gemini API 設定 ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Supabase リアルタイム同期設定 (Vite) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
