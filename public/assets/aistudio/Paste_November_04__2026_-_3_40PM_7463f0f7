              >
                <Plus className="w-3.5 h-3.5" />
                <span>ADD</span>
              </button>
            </div>

            {/* 参考書のプレビュー画面（BookTreeView）スタイルに統一された外枠 */}
            <div className="rounded-lg border border-border bg-card overflow-hidden shadow-2xs divide-y divide-border">
              {chapters.map((chapter) => {
                const isExpanded = expandedChapters[chapter.id] ?? true;
                const regularQuestionsCount = chapter.items.filter(tocItem => tocItem.kind === 'regular').length;
                const exceptionalQuestionsCount = chapter.items.filter(tocItem => tocItem.kind === 'exceptional').length;

                // PC画面(md:, lg:)では複数列、スマホ(sm以下)では単一の行（1カラム）で表示
                const STACK_SIZE = Math.max(5, Math.ceil(chapter.items.length / 5));
                const columns: { startIndex: number; items: TocItemDraft[] }[] = [];
                for (let i = 0; i < chapter.items.length; i += STACK_SIZE) {
                  columns.push({
                    startIndex: i,
                    items: chapter.items.slice(i, i + STACK_SIZE)
                  });
                }
                if (columns.length === 0) {
                  columns.push({ startIndex: 0, items: [] });
                }

                return (
                  <div key={chapter.id} className="bg-card">
                    {/* 章タイトル行（BookTreeView準拠のスタイル） */}
                    <div
                      onClick={() => setExpandedChapters(prev => ({ ...prev, [chapter.id]: !isExpanded }))}
                      className="flex shrink flex-no-wrap items-center justify-between p-3.5 bg-muted/40 hover:bg-muted/50 cursor-pointer select-none transition-colors duration-300 ease-in-out gap-2"
                    >
                      <div className="flex flex-1 min-w-0 shrink items-center gap-2" onClick={(e) => e.stopPropagation()}>
                        <button
                          type="button"
                          onClick={() => setExpandedChapters(prev => ({ ...prev, [chapter.id]: !isExpanded }))}
                          className="text-muted-foreground transition-transform duration-300 ease-in-out cursor-pointer"
                        >
                          <ChevronDown
                            className={`w-4 h-4 transition-transform duration-300 ease-in-out ${isExpanded ? 'rotate-0' : '-rotate-90'
                              }`}
                          />
                        </button>

                        <input
                          type="text"
                          value={chapter.title}
                          onChange={(e) => handleUpdateChapterTitle(chapter.id, e.target.value)}
                          placeholder="章のタイトル"
                          className="px-2.5 py-1 shrink min-w-0 bg-secondary/80 border-border border rounded text-xs font-semibold text-foreground focus:outline-none focus:ring-1 focus:ring-primary"
                        />
                      </div>

                      {/* 右: 通常問題数一括調整 & 削除 */}
                      <div className="flex items-center gap-2.5 font-mono text-[11px]" onClick={(e) => e.stopPropagation()}>
                        <div className="flex items-center gap-1.5 bg-background px-2.5 py-1 rounded border border-border">
                          <span className="text-[10px] text-muted-foreground">REGULAR:</span>
                          <input
                            type="number"
                            min={0}
                            max={300}
                            value={regularQuestionsCount}
                            onChange={(e) => handleSetRegularCount(chapter.id, parseInt(e.target.value) || 0)}
                            className="text-right font-bold text-foreground bg-transparent focus:outline-none"
                          />
                          <span className="text-[10px] text-muted-foreground">Qs</span>
                        </div>

                        <div className="text-[10px] text-muted-foreground hidden sm:block">
                          (EXCEPTION: <span className="text-(--tag-level-2) font-bold">{exceptionalQuestionsCount}</span> / TOTAL: <span className="text-foreground font-bold">{regularQuestionsCount + exceptionalQuestionsCount}</span>)
                        </div>

                        <button
                          type="button"
                          onClick={() => handleRemoveChapter(chapter.id)}
                          className="p-1 text-muted-foreground hover:text-destructive rounded transition-colors cursor-pointer"
                          title="章を削除"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </div>

                    {/* 章の目次マトリクス表示（BookTreeViewと同じgrid-template-rowsによる展開アニメーション） */}
                    <div
                      className="grid transition-[grid-template-rows] duration-300 ease-in-out"
                      style={{ gridTemplateRows: isExpanded ? '1fr' : '0fr' }}
                    >
                      <div className="overflow-hidden">
                        <div className="border-t border-border/60 bg-muted/20 p-3 sm:p-4">
                          {/* モバイル(sm以下)では単一の行(1列: flex-col)、md以上では複数列(flex-rowで横並び) */}
                          <div className="flex flex-col md:flex-row md:items-stretch md:min-w-max md:justify-between gap-0">
                            {columns.map((col, colIdx) => (
                              <React.Fragment key={colIdx}>
                                {/* PCでの区画間の縦区切り線 */}
                                {colIdx > 0 && (
                                  <div className="hidden md:flex items-center justify-center px-2 select-none">
                                    <div className="w-px h-[90%] bg-border/40" />
                                  </div>
                                )}

                                {/* 区画コンテナ: モバイルではw-full、PCでは均等幅 */}
                                <div className="w-full md:w-44 flex flex-col justify-between py-0 md:py-1 shrink-0">
                                  <div className="flex flex-col w-full justify-center">
                                    <div className="flex flex-col w-full justify-center">
                                      {[
                                        (colIdx === 0
                                          ? (<div className="">
                                            <TocItemDivider
                                              onClick={() => handleOpenInsertModal(chapter.id, 0)}
                                              label="ここに追加"
                                            />
                                          </div>
                                          )
                                          : (<div className="h-7 -my-2 hidden md:block" />)),
                                        ...col.items.map((item, itemIdx) => {
                                          const globalIndex = col.startIndex + itemIdx;
                                          const isSection = item.kind === 'section';
                                          const isExceptional = item.kind === 'exceptional';

                                          return (

                                            <div key={item.id} className="w-full">
                                              {/* 題名的要素（目次アイテム）: 囲うボーダーを設けず、同じようなサイズ感で配置 */}
                                              <div className="group relative flex items-center justify-between w-full h-8 px-1.5 select-none hover:bg-muted/40 rounded transition-colors">
                                                {/* 要素のラベル/タイトル */}
                                                <div className="flex items-center gap-1.5 flex-1 min-w-0 pr-1">
                                                  {isSection ? (
                                                    /* 節題: 若干目立つスタイル、クリックでインライン名変更可能 */
                                                    <div className="flex items-center gap-1.5 flex-1 min-w-0">
                                                      <Bookmark className="w-3.5 h-3.5 text-primary shrink-0" />
                                                      {editingItemId === item.id ? (
                                                        <input
                                                          autoFocus
                                                          type="text"
                                                          value={item.title}
                                                          onChange={(e) => handleUpdateItemTitle(chapter.id, item.id, e.target.value)}
                                                          onBlur={() => setEditingItemId(null)}
                                                          onKeyDown={(e) => {
                                                            if (e.key === 'Enter') setEditingItemId(null);
                                                          }}
                                                          className="w-full px-1.5 py-0.5 bg-secondary text-foreground text-xs font-bold border border-primary/50 rounded-xs focus:outline-none"
                                                        />
                                                      ) : (
                                                        <span
                                                          onClick={() => setEditingItemId(item.id)}
                                                          className="font-bold text-xs text-foreground tracking-tight truncate cursor-pointer hover:text-primary transition-colors"
                                                          title="クリックして節題名を編集"
                                                        >
                                                          {item.title || '節'}
                                                        </span>
                                                      )}
                                                    </div>
                                                  ) : (
                                                    /* 例題（通常 or 例外）: 同じサイズ感 */
                                                    <div className="flex items-center gap-1.5 flex-1 min-w-0">
                                                      <span
                                                        className={`w-1 h-3 rounded-2xs shrink-0 ${isExceptional ? 'bg-(--tag-level-2)' : 'bg-muted-foreground/40'
                                                          }`}
                                                      />
                                                      <span
                                                        className={`text-[11px] font-mono truncate ${isExceptional
                                                          ? 'text-(--tag-level-2) font-semibold'
                                                          : 'text-foreground/90 font-medium'
                                                          }`}
                                                      >
                                                        {item.questionType === "named" ? item.title : `${item.prefix}${item.number}`}
                                                      </span>
                                                    </div>
                                                  )}
                                                </div>

                                                {/* 削除ボタン（例外例題および余分な節題のみ表示。通常例題は削除不可） */}
                                                {(isExceptional || isSection) && (
                                                  <button
                                                    type="button"
                                                    onClick={() => handleDeleteItem(chapter.id, item.id)}
                                                    title={isSection ? '節題を削除' : '例外例題を削除'}
                                                    className="opacity-100 md:opacity-0 md:group-hover:opacity-100 pointer-coarse:opacity-100 p-0.5 text-muted-foreground/40 hover:text-destructive hover:bg-destructive/10 rounded cursor-pointer transition-opacity"
                                                  >
                                                    <X className="w-3.5 h-3.5" />
                                                  </button>
                                                )}
                                              </div>

                                              {/* 題名的要素の下の細い直線の区切り（ホバーで明るくなりクリックで追加） */}
                                              <TocItemDivider
                                                onClick={() => handleOpenInsertModal(chapter.id, globalIndex + 1)}
                                                label="ここに追加"
                                              />
                                            </div>
                                          );
                                        })
                                      ]}

                                      {/* PCのみ: 高さを揃えるための透明スロット（モバイルでは不要） */}
                                      <div className="hidden md:block">
                                        {Array.from({ length: Math.max(0, STACK_SIZE - col.items.length) }).map((_, emptyIdx) => (
                                          <div key={`empty_${emptyIdx}`} className="h-8 w-full pointer-events-none select-none opacity-0" />
                                        ))}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </React.Fragment>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* モーダルフッター */}
        <div className="px-4 sm:px-5 py-3 border-t border-border bg-muted/40 flex items-center justify-between shrink-0">
          <div className="flex items-center gap-3 text-[11px] font-mono text-muted-foreground">
            <div>
              TOTAL: <br className="block md:hidden" /><span className="font-bold text-foreground">{totalStats.totalCount}</span> Qs
            </div>
            <div>
              CYCLING TARGET: <br className="block md:hidden" /><span className="font-bold text-(--tag-level-1)">{totalStats.cyclingQuestionsCount}</span> Qs
            </div>
          </div>

          <div className="flex gap-2">
            <button
              onClick={onClose}
              className="px-3.5 py-1.5 text-xs font-mono rounded-md border border-border bg-background text-muted-foreground hover:text-foreground hover:bg-secondary transition-all cursor-pointer"
