              CANCEL
            </button>
            <button
              onClick={handleSave}
              className="px-4 py-1.5 text-xs font-mono font-bold rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-all cursor-pointer shadow-2xs"
