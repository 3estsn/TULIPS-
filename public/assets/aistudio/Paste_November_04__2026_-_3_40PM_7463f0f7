          <div className="bg-card border border-border rounded-lg shadow-2xl p-4 w-full max-w-sm text-xs h-60 flex flex-col justify-between">
            {/* 上部: ヘッダー & タブ */}
            <div className="space-y-3">
              <div className="flex items-center justify-between border-b border-border/80 pb-2">
                <span className="font-mono font-bold text-foreground flex items-center gap-1.5">
                  <Sparkles className="w-3.5 h-3.5 text-primary" />
                  <span>INSERT ITEM</span>
                </span>
                <button
                  type="button"
                  onClick={() => setInsertModalState(null)}
                  className="text-muted-foreground hover:text-foreground"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>

              {/* 種類選択タブ（例外例題 or 節題） */}
              <div className="grid grid-cols-2 gap-1.5 p-1 bg-secondary rounded text-center font-mono text-[11px]">
                <button
                  type="button"
                  onClick={() => setInsertForm({ ...insertForm, kind: 'exceptional' })}
                  className={`py-1 rounded cursor-pointer transition-all ${insertForm.kind === 'exceptional'
                    ? 'bg-card text-foreground font-bold shadow-2xs'
                    : 'text-muted-foreground hover:text-foreground'
                    }`}
                >
                  Exception
                </button>
                <button
                  type="button"
                  onClick={() => setInsertForm({ ...insertForm, kind: 'section' })}
                  className={`py-1 rounded cursor-pointer transition-all ${insertForm.kind === 'section'
                    ? 'bg-card text-foreground font-bold shadow-2xs'
                    : 'text-muted-foreground hover:text-foreground'
                    }`}
                >
                  Section
                </button>
              </div>
            </div>

            {/* 中央コンテンツ領域（固定高によりタブ切り替えでもモーダル全体の高さ・ボタン位置が不変） */}
            <div className="h-20 flex flex-col justify-center">
              {insertForm.kind === 'exceptional' ? (
                <div className="space-y-2.5">
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block text-[10px] font-mono text-muted-foreground uppercase mb-1">
                        PREFIX
                      </label>
                      <select
                        value={insertForm.prefix}
                        onChange={(e) => setInsertForm({ ...insertForm, prefix: e.target.value })}
                        className="w-full h-8 px-2.5 py-1.5 bg-secondary border border-border rounded text-xs font-mono text-foreground focus:outline-none"
                      >
                        {exceptionalConfigs.map(c => (
                          <option key={c.prefix} value={c.prefix}>
                            {c.prefix}
                          </option>
                        ))}
                      </select>
                    </div>

                    <div>
                      <label className="block text-[10px] font-mono text-muted-foreground uppercase mb-1">
                        TARGET TIME
                      </label>
                      <div className="flex items-center h-8 gap-1">
                        <input
                          type="number"
                          min={0}
                          max={120}
                          value={insertForm.targetMinutes}
                          onChange={(e) => setInsertForm({ ...insertForm, targetMinutes: parseInt(e.target.value) || defaultTargetMinutes })}
                          className="w-full px-2 py-1.5 bg-secondary border border-border rounded text-xs font-mono text-foreground text-right focus:outline-none"
                        />
                        <span className="text-[10px] font-mono text-muted-foreground">MIN</span>
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <div className="space-y-2.5">
                  <div>
                    <label className="block text-[10px] font-mono text-muted-foreground uppercase mb-1">
                      SECTION TITLE
                    </label>
                    <input
                      type="text"
                      value={insertForm.title}
                      onChange={(e) => setInsertForm({ ...insertForm, title: e.target.value })}
                      className="w-full px-2.5 py-1.5 bg-secondary border border-border rounded text-xs font-medium text-foreground focus:outline-none"
                    />
                  </div>
                </div>
              )}
            </div>

            {/* モーダルボタン（フッター固定） */}
            <div className="flex items-center justify-end gap-2 pt-2 border-t border-border/80">
              <button
                type="button"
                onClick={() => setInsertModalState(null)}
                className="px-3.5 py-1 text-xs font-mono rounded border border-border text-muted-foreground hover:bg-secondary cursor-pointer"
              >
                CANCEL
              </button>
              <button
                type="button"
                onClick={handleConfirmInsert}
                className="px-3.5 py-1 text-xs font-mono font-bold rounded bg-primary text-primary-foreground hover:bg-primary/90 cursor-pointer shadow-2xs"
              >
                INSERT
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// 題名的要素の下に配置する細い直線の区切り（触れ合わないマージンを確保し、ホバーで明るく発色）
function TocItemDivider({
  onClick,
  label
}: {
  onClick: () => void;
  label?: string;
}) {
  return (
    <div
      onClick={onClick}
      title={label}
      className="group relative flex items-center justify-center w-full h-10 md:h-7 -my-2 cursor-pointer select-none z-10"
    >
      {/* 題名的要素の下の細い直線 */}
      <div className="w-[calc(100%-1.5rem)] h-0 transition-colors border-[0.5px] border-border group-hover:border-(--accent-border)/40! duration-150 flex items-center justify-center relative">
      </div>
    </div>
  );
}