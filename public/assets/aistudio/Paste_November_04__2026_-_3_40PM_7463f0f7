                      {c.includeInCycling ? 'ON' : 'OFF'}
                    </button>

                    <button
                      type="button"
                      onClick={() => handleRemoveExceptionalConfig(c.prefix)}
                      className="hover:text-destructive cursor-pointer ml-0.5 text-xs text-muted-foreground"
                    >
                      ×
                    </button>
                  </div>
                ))}
              </div>
            </div>
          </div>

